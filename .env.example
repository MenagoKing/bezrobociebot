# Skopiuj do .env i uzupełnij. Plik .env nie powinien trafiać do repozytorium.

PORT=8787
# 127.0.0.1 = panel dostępny tylko lokalnie; na serwerze za reverse proxy (Caddy) zostaw 127.0.0.1 albo użyj Dockera
HOST=127.0.0.1
# DATA_DIR=data

# Hasło administratora (min. 10 znaków). Wymagane na serwerze zdalnym — ekran pierwszego
# ustawienia hasła działa tylko z localhost.
ADMIN_PASSWORD=

# Klucz główny do szyfrowania sekretów (base64, 32 bajty). Wygeneruj:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Bez tej zmiennej klucz zostanie utworzony w data/master.key. Zrób jego kopię POZA serwerem.
MASTER_KEY=

# Za HTTPS / reverse proxy
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_TTL_HOURS=12
LOG_LEVEL=info

# Twardy wyłącznik handlu prawdziwymi środkami. Domyślnie wyłączony — dostępny tylko tryb paper.
LIVE_TRADING_ENABLED=false
